{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["miniprogram-api-typings"],
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["miniprogram/**/*.js"],
  "exclude": ["node_modules"]
}
